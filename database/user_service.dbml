// PostgreSQL User Service — отдельная база данных сервиса пользователей.
// User Service отвечает за регистрацию, аутентификацию и профили.
// Остальные сервисы хранят user_id как внешний идентификатор без внешних ключей:
// базы разных сервисов не связаны между собой (database per service).
//
// Sharding:
// - не используется: ~21 ГБ данных и ~5 700 IOPS в пике помещаются на один SSD
// Replication:
// - master-slave, физическая потоковая (WAL, push)
// - replication factor 3: master + 1 semisync-реплика + 1 async-реплика
// - профили читаются с реплик; вход и обновление токенов — только мастер
//   (rotation refresh-токена должна видеть последнее состояние строки)
// - failover: Patroni + etcd

Project user_service {
  database_type: 'PostgreSQL'
  Note: 'База данных User Service: пользователи и их профили'
}

Table users {
  id bigserial [pk]
  username varchar(32) [not null, unique, note: 'Уникальное имя пользователя, используется в ссылке на профиль']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  display_name varchar(100) [not null, note: 'Имя, которое показывается в ленте и комментариях']
  avatar_key varchar(255) [note: 'Ключ preview аватара в S3: media/{media_id}/preview.jpg']
  bio varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  При изменении display_name или avatar_key User Service публикует событие user.updated,
  по которому обновляются кэшированные профили и карточки постов в Redis.
  '''
}

Table refresh_tokens {
  id uuid [pk, note: 'ID сессии, передаётся в access-токене как claim sid']
  user_id bigint [not null, ref: > users.id]
  token_hash varchar(64) [not null, unique, note: 'SHA-256 от refresh-токена; сам токен не хранится']
  user_agent varchar(255) [note: 'Устройство или браузер, для списка активных сессий']
  expires_at timestamptz [not null, note: 'Срок жизни refresh-токена — 30 дней']
  revoked_at timestamptz [note: 'Заполняется при выходе (DELETE /tokens/current)']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_refresh_tokens_user']
  }

  Note: '''
  Одна строка — одна сессия (устройство).
  Access-токен (JWT, 15 минут) проверяется по подписи без обращения к базе.
  Refresh-токен хранится в базе, чтобы его можно было отозвать при выходе.
  При обновлении токенов (POST /tokens, grant_type refresh_token) в той же строке
  заменяются token_hash и expires_at (rotation), поэтому старый refresh-токен перестаёт работать.
  '''
}
